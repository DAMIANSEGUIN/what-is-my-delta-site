#!/bin/zsh
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git diff --cached --check

python_bin="${WIMD_PYTHON_BIN:-python3}"
staged_python=("${(@f)$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')}")
if (( ${#staged_python[@]} )); then
  "$python_bin" -m py_compile "${staged_python[@]}"
fi
